<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>YARN – Meet with Intention</title>
<meta name="description" content="YARN is a dating platform for people who want something real. Meet with Intention.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --black:#0a0a0a; --deep:#14110a; --gold:#d4b25a; --gold-soft:#b89a48;
    --ivory:#f5efe0; --muted:#c9c1a8; --card:#15130d; --line:rgba(212,178,90,.25);
    --serif:'Cormorant Garamond',Georgia,serif; --sans:'Inter',system-ui,sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--black);color:var(--ivory);font-family:var(--sans);line-height:1.65;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  h1,h2,h3{font-family:var(--serif);font-weight:700;line-height:1.15}
  .wrap{width:min(1080px,92%);margin:0 auto}
  section{padding:84px 0}
  .eyebrow{color:var(--gold);letter-spacing:.22em;font-size:.75rem;text-transform:uppercase;margin-bottom:12px;font-weight:600}
  h2{font-size:clamp(2rem,5vw,3rem);margin-bottom:14px}
  .lead{color:var(--muted);max-width:620px}
  .center{text-align:center}.center .lead{margin:0 auto}

  /* Opening animation (about 2 seconds, then fades out by itself) */
  #splash{position:fixed;inset:0;z-index:100;background:var(--black);display:flex;flex-direction:column;align-items:center;justify-content:center;animation:splashOut .8s ease 1.7s forwards}
  #splash .logo{font-family:var(--serif);font-size:clamp(3rem,14vw,5.5rem);letter-spacing:.35em;color:var(--gold);padding-left:.35em;animation:rise 1s ease both}
  #splash .tag{font-family:var(--serif);font-style:italic;color:var(--ivory);font-size:1.3rem;animation:rise 1s ease .5s both}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes splashOut{to{opacity:0;visibility:hidden}}

  /* Navigation */
  header{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(10,10,10,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{font-family:var(--serif);font-size:1.7rem;letter-spacing:.3em;color:var(--gold);font-weight:700}
  .links{display:flex;gap:26px;align-items:center;font-size:.92rem;color:var(--muted)}
  .links a:hover{color:var(--gold)}
  #menuBtn{display:none;background:none;border:1px solid var(--line);color:var(--gold);border-radius:10px;padding:8px 12px;font-size:1rem}
  @media(max-width:760px){
    #menuBtn{display:block}
    .links{display:none;position:absolute;top:64px;left:0;right:0;flex-direction:column;background:var(--black);padding:22px;gap:18px;border-bottom:1px solid var(--line)}
    .links.open{display:flex}
  }

  /* Buttons */
  .btn{display:inline-block;padding:16px 38px;border-radius:50px;font-weight:600;letter-spacing:.08em;font-size:.95rem;cursor:pointer;border:none;transition:transform .25s,box-shadow .25s;font-family:var(--sans)}
  .btn-gold{background:linear-gradient(135deg,#e6c878,var(--gold));color:#1a1405;box-shadow:0 0 28px rgba(212,178,90,.4)}
  .btn-gold:hover{transform:translateY(-2px) scale(1.03);box-shadow:0 0 38px rgba(212,178,90,.6)}
  .btn-line{background:transparent;color:var(--ivory);border:1px solid var(--gold)}
  .btn-line:hover{background:rgba(212,178,90,.12)}
  .btns{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}

  /* Hero */
  .hero{min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;padding:0;background:radial-gradient(ellipse at 50% 25%,#2a2109 0%,var(--deep) 45%,var(--black) 80%);position:relative}
  .hero-inner{padding:130px 0 40px;text-align:center}
  .hero h1{font-size:clamp(2.4rem,7vw,4.6rem);margin-bottom:18px}
  .hero h1 em{color:var(--gold);font-style:italic}
  .hero p.lead{margin:0 auto 32px;font-size:1.1rem}
  .skyline{width:100%;height:clamp(150px,26vw,260px);display:block}
  .win{animation:twinkle 4s infinite alternate}
  @keyframes twinkle{from{opacity:.25}to{opacity:1}}

  /* Cards and grids */
  .grid{display:grid;gap:20px;margin-top:44px}
  .g3{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
  .card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:30px;transition:transform .3s,border-color .3s}
  .card:hover{transform:translateY(-4px);border-color:var(--gold)}
  .card h3{font-size:1.5rem;margin-bottom:8px;color:var(--ivory)}
  .card p{color:var(--muted);font-size:.95rem}
  .num{font-family:var(--serif);font-size:2.6rem;color:var(--gold);line-height:1;margin-bottom:10px}
  .alt{background:linear-gradient(180deg,var(--black),var(--deep),var(--black))}

  /* Verification badges */
  .badges{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .badge{border:1px solid var(--gold);border-radius:50px;padding:9px 18px;font-size:.88rem;color:var(--gold);display:flex;gap:8px;align-items:center}
  .badge::before{content:"✓";font-weight:700}
  .note{margin-top:22px;font-size:.88rem;color:var(--muted);border-left:2px solid var(--gold);padding-left:14px;max-width:640px}

  /* Intentions */
  .chips{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:34px}
  .chip{border:1px solid var(--line);background:var(--card);border-radius:50px;padding:12px 22px;font-size:.95rem}

  /* Split layout */
  .split{display:grid;gap:40px;grid-template-columns:1fr 1fr;align-items:center}
  @media(max-width:760px){.split{grid-template-columns:1fr}}
  .visual{aspect-ratio:4/3;border-radius:26px;border:1px solid var(--line);background:radial-gradient(circle at 30% 30%,#3a2d0c,var(--deep) 60%,var(--black));display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;color:var(--muted);font-family:var(--serif);font-style:italic;font-size:1.2rem}
  .steps{list-style:none;margin-top:22px}
  .steps li{padding:12px 0 12px 34px;position:relative;color:var(--muted);border-bottom:1px solid rgba(212,178,90,.12)}
  .steps li::before{content:"♦";position:absolute;left:0;color:var(--gold)}

  /* FAQ */
  details{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 22px;margin-top:14px}
  summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:12px}
  summary::after{content:"+";color:var(--gold);font-size:1.3rem;line-height:1}
  details[open] summary::after{content:"–"}
  details p{margin-top:12px;color:var(--muted);font-size:.95rem}
  .faq{max-width:760px;margin:36px auto 0}

  /* Final CTA and footer */
  .final{text-align:center;background:radial-gradient(ellipse at 50% 100%,#2a2109,var(--black) 70%)}
  footer{border-top:1px solid var(--line);padding:42px 0;color:var(--muted);font-size:.85rem}
  .foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px}
  .foot nav{display:flex;gap:20px;flex-wrap:wrap}
  .foot a:hover{color:var(--gold)}
  .fine{margin-top:22px;font-size:.78rem;opacity:.75;max-width:720px}

  /* Scroll reveal */
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}
  .reveal.show{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}#splash{display:none}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>

<div id="splash" aria-hidden="true">
  <div class="logo">YARN</div>
  <div class="tag">Meet with Intention.</div>
</div>

<header>
  <div class="wrap nav">
    <a href="#top" class="brand">YARN</a>
    <button id="menuBtn" aria-label="Open menu">Menu</button>
    <nav class="links" id="links">
      <a href="#how">How it works</a>
      <a href="#verification">Verification</a>
      <a href="#matching">Matching</a>
      <a href="#dates">Dates</a>
      <a href="#safety">Safety</a>
      <a href="#faq">FAQ</a>
      <a href="#join" class="btn btn-gold" style="padding:10px 22px">LET'S YARN</a>
    </nav>
  </div>
</header>

<main id="top">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="eyebrow">YARN · Meet with Intention.</div>
      <h1>Your next connection could <em>change everything.</em></h1>
      <p class="lead">Meet people who share your values, understand your ambitions, and are ready for something real.</p>
      <div class="btns">
        <button class="btn btn-gold" onclick="letsYarn()">LET'S YARN</button>
        <a href="#how" class="btn btn-line">How YARN Works</a>
      </div>
    </div>
    <svg class="skyline" id="skyline" viewBox="0 0 1200 260" preserveAspectRatio="xMidYMax slice" aria-label="City skyline"></svg>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="wrap center reveal">
      <div class="eyebrow">How YARN works</div>
      <h2>Simple steps. Serious intent.</h2>
      <p class="lead">No endless swiping. YARN is built around what you are actually looking for.</p>
      <div class="grid g3" style="text-align:left">
        <div class="card"><div class="num">1</div><h3>Create your profile</h3><p>Share who you are, what you do, and what you value. You choose which optional details to show.</p></div>
        <div class="card"><div class="num">2</div><h3>Choose your intention</h3><p>Tell us what you are looking for, from a serious relationship to marriage-minded dating.</p></div>
        <div class="card"><div class="num">3</div><h3>Match and meet</h3><p>When interest is mutual, you can chat and plan a real-life date in a public place.</p></div>
      </div>
    </div>
  </section>

  <!-- VERIFICATION -->
  <section id="verification" class="alt">
    <div class="wrap reveal">
      <div class="eyebrow">Identity & profile verification</div>
      <h2>Trust you can see.</h2>
      <p class="lead">Each badge shows one specific check that was actually completed. Badges are never given for claims alone, and your documents are never shown to other members.</p>
      <div class="badges">
        <span class="badge">Identity Verified</span>
        <span class="badge">Education Verified</span>
        <span class="badge">Career Verified</span>
        <span class="badge">Business Verified</span>
        <span class="badge">Financial Stability Verified</span>
        <span class="badge">Background Check Completed</span>
      </div>
      <p class="note">Verification helps, but it cannot remove every risk of meeting people. Everyone is welcome: students, recent graduates, professionals and business owners each have a fair way to verify.</p>
    </div>
  </section>

  <!-- MATCHING -->
  <section id="matching">
    <div class="wrap split reveal">
      <div>
        <div class="eyebrow">Meaningful matching</div>
        <h2>Beyond appearance.</h2>
        <p class="lead">Recommendations consider what matters over time.</p>
        <ul class="steps">
          <li>Relationship intentions</li>
          <li>Values and lifestyle</li>
          <li>Education and career, where relevant</li>
          <li>Shared interests, age and location preferences</li>
        </ul>
      </div>
      <div class="visual">Real connection starts with shared values.</div>
    </div>
  </section>

  <!-- INTENTIONS -->
  <section class="alt">
    <div class="wrap center reveal">
      <div class="eyebrow">Relationship intentions</div>
      <h2>Say what you are looking for.</h2>
      <p class="lead">Being honest about intent saves everyone's time.</p>
      <div class="chips">
        <span class="chip">A serious relationship</span>
        <span class="chip">A potential life partner</span>
        <span class="chip">Dating to find a committed relationship</span>
        <span class="chip">Getting to know someone first</span>
        <span class="chip">Marriage-minded dating</span>
      </div>
    </div>
  </section>

  <!-- DATES -->
  <section id="dates">
    <div class="wrap split reveal">
      <div class="visual">From conversation to a real table for two.</div>
      <div>
        <div class="eyebrow">Real-life date planning</div>
        <h2>Move beyond the chat.</h2>
        <p class="lead">Matched members can propose a date, suggest a place, and confirm a time.</p>
        <ul class="steps">
          <li>Propose, accept, decline or reschedule</li>
          <li>Public first-date place suggestions</li>
          <li>Your precise location is never shared without permission</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SAFETY -->
  <section id="safety" class="alt">
    <div class="wrap center reveal">
      <div class="eyebrow">Privacy & safety</div>
      <h2>Built to protect you.</h2>
      <div class="grid g3" style="text-align:left">
        <div class="card"><h3>You are in control</h3><p>Block, report and unmatch at any time. Choose what optional details to share.</p></div>
        <div class="card"><h3>Private by design</h3><p>No public home addresses, ID numbers or live locations. Verification documents stay private.</p></div>
        <div class="card"><h3>Active moderation</h3><p>Reports of harassment, scams and fake profiles are reviewed by trained staff.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="wrap center reveal">
      <div class="eyebrow">FAQ</div>
      <h2>Good questions.</h2>
      <div class="faq" style="text-align:left">
        <details><summary>Who can join YARN?</summary><p>Adults aged 18 and above. Age is confirmed through identity verification.</p></details>
        <details><summary>Do I need to be wealthy or established to join?</summary><p>No. Verification is optional and has pathways for students, graduates, employees and business owners. Income does not decide your worth.</p></details>
        <details><summary>Are my documents visible to other members?</summary><p>Never. Others only see which verification badges you have earned.</p></details>
        <details><summary>Does verification guarantee someone is safe?</summary><p>No. It reduces risk but cannot remove it. We encourage first dates in public places.</p></details>
        <details><summary>Is YARN free?</summary><p>Pricing has not been decided yet. We will be clear about any costs before you pay for anything.</p></details>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="join" class="final">
    <div class="wrap reveal">
      <div class="eyebrow">Ready when you are</div>
      <h2>Meet with Intention.</h2>
      <p class="lead" style="margin-bottom:30px">Join people who want something real, at their own pace.</p>
      <button class="btn btn-gold" onclick="letsYarn()">LET'S YARN</button>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="foot">
      <div><span class="brand" style="font-size:1.3rem">YARN</span><br>Meet with Intention.</div>
      <nav><a href="#how">How it works</a><a href="#verification">Verification</a><a href="#safety">Safety</a><a href="#faq">FAQ</a></nav>
    </div>
    <p class="fine">© 2026 YARN. Early design prototype: sign-up, verification, matching and messaging are not built yet. Any example content is fictional.</p>
  </div>
</footer>

<script>
  // Placeholder button (real sign-up arrives in Phase 2)
  function letsYarn(){ alert("Sign-up is coming soon. YARN is still being built!"); }

  // Mobile menu
  var links = document.getElementById("links");
  document.getElementById("menuBtn").onclick = function(){ links.classList.toggle("open"); };
  links.querySelectorAll("a").forEach(function(a){ a.onclick = function(){ links.classList.remove("open"); }; });

  // Skyline: buildings with softly twinkling windows
  (function(){
    var svg = document.getElementById("skyline"), html = "", x = 0, seed = 7;
    function rnd(){ seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }
    while(x < 1200){
      var w = 40 + Math.floor(rnd()*50), h = 60 + Math.floor(rnd()*150), y = 260 - h;
      html += '<rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" fill="#1c1708" stroke="#d4b25a" stroke-opacity=".35"/>';
      if(rnd() > .7) html += '<polygon points="'+x+','+y+' '+(x+w/2)+','+(y-22)+' '+(x+w)+','+y+'" fill="#1c1708" stroke="#d4b25a" stroke-opacity=".35"/>';
      for(var wy = y + 14; wy < 250; wy += 20){
        for(var wx = x + 8; wx < x + w - 8; wx += 14){
          if(rnd() > .55) html += '<rect class="win" style="animation-delay:'+(rnd()*4).toFixed(1)+'s" x="'+wx+'" y="'+wy+'" width="6" height="9" fill="#e6c878"/>';
        }
      }
      x += w + 4;
    }
    svg.innerHTML = html;
  })();

  // Fade sections in as you scroll
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("show"); io.unobserve(e.target); } });
  }, {threshold:.12});
  document.querySelectorAll(".reveal").forEach(function(el){ io.observe(el); });
</script>
</body>
</html>
